{
  "name": "rakuraku-music-world",
  "private": true,
  "version": "2.0.0",
  "description": "RakurakuMusicWorld - community radio web and desktop client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "node ../../electron/scripts/dev.mjs",
    "electron:build": "npm run build && electron-builder",
    "electron:start": "node ../../electron/scripts/dev.mjs --no-server"
  },
  "dependencies": {
    "@appica/icons-react": "1.0.0",
    "@appica/ui-react": "1.1.0",
    "@base-ui/react": "1.8.0",
    "@material/material-color-utilities": "0.4.0",
    "clsx": "2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0"
  },
  "build": {
    "appId": "in.kawaiis.RakurakuMusicWorld",
    "productName": "RakurakuMusicWorld",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../../electron/main.mjs",
        "to": "app/main.mjs"
      },
      {
        "from": "../../electron/preload.mjs",
        "to": "app/preload.mjs"
      },
      {
        "from": "../../electron/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../../electron/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "../../electron/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "RakurakuMusicWorld-Setup-${version}.${ext}"
    },
    "linux": {
      "icon": "../../electron/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "mac": {
      "icon": "../../electron/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    }
  }
}
