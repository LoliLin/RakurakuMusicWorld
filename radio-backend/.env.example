# 通过环境变量覆盖单个设置（对应 config.rs AppConfig::load 的读取项）
RADIO_DATABASE_URL=sqlite://data/radio.db?mode=rwc
RADIO_SERVER_PORT=2241
RADIO_BASE_PATH=/
RADIO_LOG_LEVEL=info
RADIO_MEDIA_PATH=./media
RADIO_STREAM_BASE=auto
RADIO_CROSSFADE_ENABLED=false
RADIO_STATION_NAME=RakurakuMusicWorld
RADIO_ADMIN_SETUP_TOKEN=change-me-in-production
RADIO_NCM_DEVICE_ID=
RADIO_NCM_DOWNLOAD_CONCURRENCY=1
